# ============================================================
# ChainStrike — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── NODE ────────────────────────────────────────────────────
NODE_ENV=development

# ── DATABASES ───────────────────────────────────────────────
# Shared PostgreSQL instance; each service uses its own schema
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chainstrike
POSTGRES_PASSWORD=chainstrike_dev_password
POSTGRES_DB=chainstrike

# Per-service DATABASE_URL (schema= isolates each service)
IDENTITY_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:5432/chainstrike?schema=identity
ASSET_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:5432/chainstrike?schema=asset
COMPLIANCE_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:5432/chainstrike?schema=compliance
SETTLEMENT_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:5432/chainstrike?schema=settlement
ANALYTICS_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:5432/chainstrike?schema=analytics

# ── JWT / AUTH ───────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-min-64-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ALGORITHM=HS256

# ── INTERNAL SERVICE AUTH ────────────────────────────────────
# Shared secret for /internal/* routes between microservices.
# Generate: openssl rand -hex 32
INTERNAL_SECRET=change-this-before-deploying-to-production

# ── ALGORAND ─────────────────────────────────────────────────
# LocalNet (AlgoKit sandbox) defaults
ALGOD_HOST=http://localhost
ALGOD_PORT=4001
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

INDEXER_HOST=http://localhost
INDEXER_PORT=8980
INDEXER_TOKEN=

ALGORAND_NETWORK=localnet
# testnet | mainnet | localnet

# Platform settlement key (KMS-managed in production, hot wallet for dev only)
SETTLEMENT_MNEMONIC=

# Platform compliance oracle address (whitelist updater)
COMPLIANCE_ORACLE_ADDRESS=
COMPLIANCE_ORACLE_MNEMONIC=

# USDC ASA ID (on Algorand)
# MainNet: 31566704 | TestNet: 10458941 | LocalNet: deployed locally
USDC_ASSET_ID=

# ── KYC PROVIDER — SUMSUB ─────────────────────────────────────
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_WEBHOOK_SECRET=

# ── BLOCKCHAIN ANALYTICS — CHAINALYSIS ───────────────────────
CHAINALYSIS_API_KEY=
CHAINALYSIS_BASE_URL=https://api.chainalysis.com

# ── EMAIL — SENDGRID ─────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@chainstrike.io
SENDGRID_FROM_NAME=ChainStrike

# ── AWS (document storage + KMS) ─────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_DOCUMENTS=chainstrike-documents-dev
AWS_KMS_KEY_ID=

# ── SERVICE PORTS ────────────────────────────────────────────
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
ASSET_SERVICE_PORT=3002
COMPLIANCE_SERVICE_PORT=3003
SETTLEMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
ANALYTICS_SERVICE_PORT=3007

# ── FRONTEND URLs ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_ALGORAND_NETWORK=localnet
