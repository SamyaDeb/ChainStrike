# ─── ChainStrike Testnet Environment ─────────────────────────────────────────
# Copy to .env and fill in REQUIRED values before running

NODE_ENV=development

# ─── Algorand Testnet (AlgoNode - free, no auth required) ────────────────────
ALGORAND_NETWORK=testnet
ALGORAND_ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_PORT=443
ALGORAND_ALGOD_TOKEN=
ALGORAND_INDEXER_SERVER=https://testnet-idx.algonode.cloud
ALGORAND_INDEXER_PORT=443

# REQUIRED: Generate with `algokey generate` or use Pera Wallet export
# Fund with testnet faucet: https://bank.testnet.algorand.network
ALGORAND_ADMIN_MNEMONIC="crack scout prefer purchase seat fever tilt tornado knee ridge twice pulp man card stereo worry come disease thunder crash liberty toss leader abstract toss"
ALGORAND_COMPLIANCE_MNEMONIC="crack scout prefer purchase seat fever tilt tornado knee ridge twice pulp man card stereo worry come disease thunder crash liberty toss leader abstract toss"

# Testnet USDC Asset ID (official USDC on Algorand testnet)
USDC_ASSET_ID=10458941

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=chainstrike
POSTGRES_PASSWORD=chainstrike_dev_password
POSTGRES_DB=chainstrike

IDENTITY_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:55432/chainstrike
ASSET_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:55432/chainstrike
COMPLIANCE_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:55432/chainstrike
SETTLEMENT_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:55432/chainstrike
ANALYTICS_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:55432/chainstrike
NOTIFICATION_DATABASE_URL=postgresql://chainstrike:chainstrike_dev_password@localhost:55432/chainstrike

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED: Generate 32 random bytes: `openssl rand -hex 32`
JWT_SECRET=a1b2c3d4e5f6789012345678abcdef0123456789abcdef0123456789abcdef01
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Sumsub KYC (get from app.sumsub.com) ────────────────────────────────────
# Use Sumsub sandbox for testnet
SUMSUB_APP_TOKEN=REPLACE_WITH_SUMSUB_SANDBOX_TOKEN
SUMSUB_SECRET_KEY=REPLACE_WITH_SUMSUB_SANDBOX_SECRET
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_WEBHOOK_SECRET=REPLACE_WITH_SUMSUB_WEBHOOK_SECRET

# ─── Chainalysis (optional for testnet - mock will be used if absent) ─────────
CHAINALYSIS_API_KEY=OPTIONAL_FOR_TESTNET
CHAINALYSIS_API_URL=https://api.chainalysis.com

# ─── AWS S3 (use LocalStack for local testing) ────────────────────────────────
# For testnet, you can use LocalStack: https://localstack.cloud
# Or use a real S3 bucket with test prefix
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET_DOCUMENTS=chainstrike-documents-testnet
# Uncomment for LocalStack:
# AWS_S3_ENDPOINT=http://localhost:4566

# ─── Service Ports ────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=3001
ASSET_SERVICE_PORT=3002
COMPLIANCE_SERVICE_PORT=3004
SETTLEMENT_PORT=3005
NOTIFICATION_PORT=3006
ANALYTICS_PORT=3007

# ─── Service URLs (for inter-service calls) ───────────────────────────────────
IDENTITY_SERVICE_URL=http://localhost:3001
ASSET_SERVICE_URL=http://localhost:3002
COMPLIANCE_SERVICE_URL=http://localhost:3004
SETTLEMENT_SERVICE_URL=http://localhost:3005

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ALGORAND_NETWORK=testnet
# WalletConnect Project ID from cloud.walletconnect.com (free tier available)
NEXT_PUBLIC_WC_PROJECT_ID=REPLACE_WITH_WALLETCONNECT_PROJECT_ID
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:3101

# ─── Treasury wallet (receives platform fees) ────────────────────────────────
TREASURY_WALLET_ADDRESS=HMPG7YLTESN4FQXIGCAHQOXDEIDUIFBOINJDGQ7WUFBTYMOIKDIN6CITPM

# ─── Deployed contract IDs (filled after running deploy-contracts.ts) ─────────
WHITELIST_REGISTRY_APP_ID=762425821
ESCROW_CONTRACT_APP_ID=762425828
TRANSFER_RESTRICTION_APP_ID=762425829
