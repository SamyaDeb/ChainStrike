    frame_dig -1
    /
    frame_bury 1
    // perpetuals_market.py:1018
    // if is_long:
    frame_dig -4
    bz _calculate_liquidation_price_else_body@8
    // perpetuals_market.py:1019-1020
    // # Long liquidates when price drops
    // if entry_price > price_change:
    frame_dig -3
    frame_dig 1
    >
    bz _calculate_liquidation_price_else_body@7
    // perpetuals_market.py:1021
    // return entry_price - price_change
    frame_dig -3
    frame_dig 1
    -
    frame_bury 0
    retsub

_calculate_liquidation_price_else_body@7:
    // perpetuals_market.py:1023
    // return UInt64(1)  # Minimum price
    intc_1 // 1
    frame_bury 0
    retsub

_calculate_liquidation_price_else_body@8:
    // perpetuals_market.py:1025-1026
    // # Short liquidates when price rises
    // return entry_price + price_change
    frame_dig -3
    frame_dig 1
    +
    frame_bury 0
    retsub
