generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/compliance-client"
}

datasource db {
  provider = "postgresql"
  url      = env("COMPLIANCE_DATABASE_URL")
}

// ─── Whitelist Entry ──────────────────────────────────────────────────────────

model WhitelistEntry {
  id             String    @id @default(uuid())
  walletAddress  String
  assetId        String
  asaId          Int
  userId         String
  kycTier        Int
  isActive       Boolean   @default(true)
  addedAt        DateTime  @default(now())
  expiresAt      DateTime?
  removedAt      DateTime?
  removedReason  String?
  onChainTxId    String?

  @@unique([walletAddress, assetId])
  @@index([walletAddress])
  @@index([assetId])
  @@index([userId])
}

// ─── Transfer Rule ────────────────────────────────────────────────────────────

model TransferRule {
  id        String   @id @default(uuid())
  assetId   String
  ruleType  String
  value     String
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

// ─── AML Alert ────────────────────────────────────────────────────────────────

model AmlAlert {
  id            String    @id @default(uuid())
  userId        String?
  walletAddress String?
  tradeId       String?
  orderId       String?
  alertType     String
  status        String    @default("OPEN")
  severity      String    @default("MEDIUM")
  description   String
  rawData       String?
  detectedAt    DateTime  @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?
  resolution    String?

  sarReport SarReport?

  @@index([userId])
  @@index([status])
  @@index([detectedAt])
}

// ─── SAR Report ──────────────────────────────────────────────────────────────

model SarReport {
  id                  String    @id @default(uuid())
  alertId             String    @unique
  status              String    @default("DRAFT")
  narrativeText       String?
  fiuReference        String?
  filingJurisdiction  String
  filedAt             DateTime?
  filedBy             String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  alert AmlAlert @relation(fields: [alertId], references: [id])
}

// ─── Compliance Event (Append-Only) ──────────────────────────────────────────

model ComplianceEvent {
  id           String   @id @default(uuid())
  eventType    String
  subjectType  String
  subjectId    String
  actorId      String
  actorType    String
  description  String
  metadata     String   @default("{}")
  onChainTxId  String?
  createdAt    DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── Wallet Risk Score ────────────────────────────────────────────────────────

model WalletRiskScore {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  riskBand      String
  score         Int
  exposures     String   @default("[]")
  provider      String
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Sanctions Screening Result ───────────────────────────────────────────────

model SanctionsScreeningResult {
  id              String   @id @default(uuid())
  userId          String
  isMatch         Boolean
  matchedLists    String   @default("")
  matchedNames    String   @default("")
  screenerAt      DateTime @default(now())
  requiresReview  Boolean  @default(false)

  @@index([userId])
  @@index([screenerAt])
}
