generator client {
  previewFeatures = ["multiSchema"]
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/compliance-client"
}

datasource db {
  provider = "postgresql"
  url      = env("COMPLIANCE_DATABASE_URL")
  schemas  = ["compliance", "public"]
}

// ─── Whitelist Entry ──────────────────────────────────────────────────────────

model WhitelistEntry {
  id             String    @id @default(uuid())
  walletAddress  String
  assetId        String    // Platform asset UUID
  asaId          Int       // Algorand ASA ID
  userId         String
  kycTier        Int
  isActive       Boolean   @default(true)
  addedAt        DateTime  @default(now())
  expiresAt      DateTime?
  removedAt      DateTime?
  removedReason  String?
  onChainTxId    String?   // Algorand TX that updated on-chain whitelist

  @@unique([walletAddress, assetId])
  @@index([walletAddress])
  @@index([assetId])
  @@index([userId])
  @@schema("compliance")
}

// ─── Transfer Rule ────────────────────────────────────────────────────────────

model TransferRule {
  id        String   @id @default(uuid())
  assetId   String
  ruleType  String   // TransferRuleType enum value
  value     Json     // Rule-specific config
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@schema("compliance")
}

// ─── AML Alert ────────────────────────────────────────────────────────────────

model AmlAlert {
  id            String          @id @default(uuid())
  userId        String?
  walletAddress String?
  tradeId       String?
  orderId       String?
  alertType     String
  status        AmlAlertStatus  @default(OPEN)
  severity      AlertSeverity   @default(MEDIUM)
  description   String
  rawData       Json?           // Alert source data
  detectedAt    DateTime        @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?
  resolution    String?

  sarReport SarReport?

  @@index([userId])
  @@index([status])
  @@index([detectedAt])
  @@schema("compliance")
}

enum AmlAlertStatus {
  OPEN
  UNDER_REVIEW
  CLEARED
  ESCALATED
  SAR_FILED

  @@schema("compliance")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("compliance")
}

// ─── SAR Report ──────────────────────────────────────────────────────────────

model SarReport {
  id                  String    @id @default(uuid())
  alertId             String    @unique
  status              SarStatus @default(DRAFT)
  narrativeText       String?
  fiuReference        String?
  filingJurisdiction  String
  filedAt             DateTime?
  filedBy             String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  alert AmlAlert @relation(fields: [alertId], references: [id])

  @@schema("compliance")
}

enum SarStatus {
  DRAFT
  PENDING_APPROVAL
  FILED
  REJECTED

  @@schema("compliance")
}

// ─── Compliance Event (Append-Only) ──────────────────────────────────────────

model ComplianceEvent {
  id           String   @id @default(uuid())
  eventType    String
  subjectType  String
  subjectId    String
  actorId      String
  actorType    String
  description  String
  metadata     Json     @default("{}")
  onChainTxId  String?
  createdAt    DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([eventType])
  @@index([createdAt])
  @@schema("compliance")
}

// ─── Wallet Risk Score ────────────────────────────────────────────────────────

model WalletRiskScore {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  riskBand      String   // AmlRiskBand
  score         Int
  exposures     Json     @default("[]")
  provider      String
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("compliance")
}

// ─── Sanctions Screening Result ───────────────────────────────────────────────

model SanctionsScreeningResult {
  id            String   @id @default(uuid())
  userId        String
  isMatch       Boolean
  matchedLists  String[] @default([])
  matchedNames  String[] @default([])
  screenerAt    DateTime @default(now())
  requiresReview Boolean @default(false)

  @@index([userId])
  @@index([screenerAt])
  @@schema("compliance")
}
