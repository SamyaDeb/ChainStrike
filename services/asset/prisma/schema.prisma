generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/asset-client"
}

datasource db {
  provider = "postgresql"
  url      = env("ASSET_DATABASE_URL")
}

// ─── Asset ────────────────────────────────────────────────────────────────────

model Asset {
  id                         String   @id @default(uuid())
  issuerId                   String
  name                       String
  ticker                     String   @unique
  category                   String
  description                String
  status                     String   @default("DRAFT")

  // Algorand
  asaId                      Int?     @unique
  complianceContractId       Int?
  settlementContractId       Int?

  // Tokenization
  totalSupply                BigInt   @default(0)
  poolTokenAmount            BigInt?
  decimals                   Int
  pricePerToken              BigInt?
  tokenizationRatio          String?
  minimumInvestment          BigInt   @default(0)
  lockupDays                 Int      @default(0)

  // On-chain proof that issuer deposited their own minimumInvestment amount at launch
  initialLiquidityTxId       String?

  // Issuer liquidity deposit — USDC sent at token creation to determine initial token allocation
  liquidityDepositUsdc       BigInt?
  liquidityDepositTxId       String?

  // Issuer's Algorand wallet — captured at form submission; tokens auto-sent here on ASA deploy
  issuerWalletAddress        String?

  // Algorand app ID of the deployed TokenVault contract (legacy; no longer used in AMM flow)
  vaultContractId            Int?

  // Tinyman V2 AMM pool — populated on activateMarket
  tinymanPoolAddress         String?
  tinymanAppId               BigInt?
  lpAssetId                  BigInt?
  issuerLpAmount             BigInt?   // LP tokens sent to issuer at pool creation
  lpLockupEndDate            DateTime? // issuer cannot remove liquidity before this date (90 days)

  // Issuance liquidity escrow — on-chain USDC hold during verification pipeline
  issuanceEscrowTxId         String?  // issuer's on-chain USDC → escrow transfer txId
  issuanceEscrowAmount       BigInt?  // micro-USDC locked in IssuanceLiquidityEscrow contract
  issuanceEscrowStatus       String?  // PENDING | RELEASED_TO_VAULT | RETURNED_TO_ISSUER
  issuanceEscrowReleaseTxId  String?  // txId of releaseToVault or returnToIssuer on-chain call

  // Custody
  custodianName              String?
  custodianJurisdiction      String?
  spvEntityName              String?

  // Token logo (data URL or hosted URL, set at creation)
  logoUrl                    String?

  // Metadata (ARC-3)
  metadataIpfsCid            String?
  metadataHash               String?

  // Compliance
  jurisdictionBlocklist      String   @default("")
  minimumKycTier             Int      @default(1)
  accreditedInvestorRequired Boolean  @default(false)

  verificationStatus         String   @default("PENDING")
  listedAt                   DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  deletedAt                  DateTime?

  documents        AssetDocument[]
  verificationLogs AssetVerificationLog[]
  corporateActions CorporateAction[]

  @@index([issuerId])
  @@index([status])
}

// ─── Asset Document ───────────────────────────────────────────────────────────

model AssetDocument {
  id           String    @id @default(uuid())
  assetId      String
  type         String
  fileName     String
  storageKey   String
  documentHash String
  isPublic     Boolean   @default(false)
  verifiedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
}

// ─── Asset Verification Log ───────────────────────────────────────────────────

model AssetVerificationLog {
  id          String    @id @default(uuid())
  assetId     String
  stage       Int
  status      String
  reviewerId  String?
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
}

// ─── Corporate Action ─────────────────────────────────────────────────────────

model CorporateAction {
  id              String    @id @default(uuid())
  assetId         String
  type            String
  recordDate      DateTime
  paymentDate     DateTime?
  amountPerToken  BigInt?
  totalAmount     BigInt?
  status          String    @default("ANNOUNCED")
  onChainTxId     String?
  announcementUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
}

// ─── Price Snapshot (Tinyman pool reserve snapshots for chart) ───────────────

model PriceSnapshot {
  id        String   @id @default(uuid())
  assetId   String
  asaId     Int
  price     Float
  ts        DateTime @default(now())

  @@index([assetId, ts])
  @@index([asaId])
}

// ─── Oracle Price ─────────────────────────────────────────────────────────────

model OraclePrice {
  id          String   @id @default(uuid())
  asaId       Int
  assetId     String
  price       BigInt
  source      String
  timestamp   DateTime
  signature   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([asaId])
  @@index([assetId])
}
