generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/orderbook-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── Market ───────────────────────────────────────────────────────────────────

model Market {
  id                   String    @id @default(uuid())
  assetId              String    @unique
  asaId                Int       @unique
  ticker               String    @unique
  status               String    @default("PRE_MARKET")
  referencePriceUsdc   BigInt?
  upperPriceBand       BigInt?
  lowerPriceBand       BigInt?
  lastTradedPrice      BigInt?
  volume24h            BigInt    @default(0)
  circuitBreakerActive Boolean   @default(false)
  circuitBreakerUntil  DateTime?
  openedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders Order[]
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id                String    @id @default(uuid())
  marketId          String
  userId            String
  walletAddress     String
  side              String
  type              String
  timeInForce       String    @default("GTC")
  price             BigInt?
  quantity          BigInt
  filledQuantity    BigInt    @default(0)
  remainingQuantity BigInt
  status            String    @default("NEW")
  rejectionReason   String?
  escrowTxId        String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  market     Market  @relation(fields: [marketId], references: [id])
  buyTrades  Trade[] @relation("BuyOrder")
  sellTrades Trade[] @relation("SellOrder")

  @@index([marketId, status, side, price])
  @@index([userId])
  @@index([createdAt])
}

// ─── Trade ────────────────────────────────────────────────────────────────────

model Trade {
  id                   String    @id @default(uuid())
  marketId             String
  buyOrderId           String
  sellOrderId          String
  buyerUserId          String
  sellerUserId         String
  buyerWalletAddress   String
  sellerWalletAddress  String
  price                BigInt
  quantity             BigInt
  totalValue           BigInt
  platformFee          BigInt
  feeRate              Float
  status               String    @default("MATCHED")
  settlementAttempts   Int       @default(0)
  onChainTxId          String?
  settledAt            DateTime?
  failureReason        String?
  matchedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  buyOrder  Order @relation("BuyOrder",  fields: [buyOrderId],  references: [id])
  sellOrder Order @relation("SellOrder", fields: [sellOrderId], references: [id])

  @@index([marketId])
  @@index([status])
  @@index([matchedAt])
}

// ─── OHLCV Bar (time-series) ──────────────────────────────────────────────────

model OhlcvBar {
  id        String   @id @default(uuid())
  marketId  String
  interval  String
  timestamp DateTime
  open      BigInt
  high      BigInt
  low       BigInt
  close     BigInt
  volume    BigInt
  trades    Int

  @@unique([marketId, interval, timestamp])
  @@index([marketId, interval, timestamp])
}
